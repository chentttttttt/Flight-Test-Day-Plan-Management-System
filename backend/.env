# 数据库
DATABASE_URL=postgres://postgres:root@localhost:5432/flight_plan
DATABASE_TEST_URL=postgres://postgres:root@localhost:5432/flight_plan_test

# JWT配置
JWT_SECRET=your_jwt_secret_key_123456
# 自定义密钥
JWT_EXPIRE_HOURS=10
# Token过期时间
JWT_EXPIRE_SECONDS='10 * 60 * 60'

# 应用配置
APP_HOST=0.0.0.0
APP_PORT=8080
LOG_LEVEL=info

MINIO_ENDPOINT=
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=exc
MINIO_REGION=us-east-1
MINIO_SECURE=false
